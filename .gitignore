# Native build output (the projects themselves are committed)
dist-native
android/app/build
android/build
android/.gradle
ios/App/Pods
ios/App/build
marketing/ad-30s/assets/

# 60 s ad: generated media stays out of git
marketing/ad-60s/assets/
