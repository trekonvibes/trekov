{
  "appId": "com.trekov.app",
  "appName": "Trekov",
  "webDir": "dist-native",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "hostname": "trekov.com"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0B0F0E"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0B0F0E"
  },
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": false,
      "appReadyTimeout": 15000,
      "resetWhenUpdate": true,
      "statsUrl": ""
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "SystemBars": {
      "style": "DARK"
    }
  }
}
